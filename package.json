    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
