# MySQL database on Hostinger
DATABASE_URL=mysql://your_database_user:your_database_password@127.0.0.1:3306/your_database_name

# Required: generate a unique random secret of at least 32 characters.
# Example generation: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Exact frontend origins allowed by CORS (comma-separated if multiple)
FRONTEND_URL=https://www.your-aqsazone-domain.com
# FRONTEND_URLS=https://www.your-aqsazone-domain.com,https://your-aqsazone-domain.com
