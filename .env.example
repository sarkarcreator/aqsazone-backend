# PostgreSQL
SQL_HOST=127.0.0.1
SQL_USER=your_database_user
SQL_PASSWORD=your_database_password
SQL_DB_NAME=your_database_name

# Admin authentication
ADMIN_PASSCODE=change-this-to-a-strong-password

# Firebase Admin (required only if Google/Firebase admin login is used)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Frontend origins allowed by CORS
FRONTEND_URL=http://localhost:3000
# FRONTEND_URLS=http://localhost:3000,https://www.aqsazone.com
